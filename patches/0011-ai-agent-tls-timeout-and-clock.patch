+/* SiliconLoop: monotonic seconds. The wall clock jumps from 1970 to
+ * the real date on the first TLS handshake of a board without an RTC,
+ * so idle time must not be measured with time(NULL).
+ */
+static time_t pool_now(void)
+{
+    struct timespec ts;
+
+    if (clock_gettime(CLOCK_MONOTONIC, &ts) == 0) {
+        return ts.tv_sec;
+    }
+
+    return time(NULL);
+}
