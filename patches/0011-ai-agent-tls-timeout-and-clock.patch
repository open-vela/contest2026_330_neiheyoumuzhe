+/* Parse an HTTP-date (RFC 7231 IMF-fixdate) into a time_t.
+ * Example: "Wed, 16 Sep 2026 11:15:20 GMT"
+ *
+ * strptime() is declared on this platform but not linked in, so the
+ * fixed-width format is parsed directly. Returns 0 on failure.
+ */
+static time_t parse_http_date(const char* s)
+{
+    static const char months[] =
+        "JanFebMarAprMayJunJulAugSepOctNovDec";
+    char mon[4] = { 0 };
+    struct tm tm;
+    int day, year, hour, min, sec;
+
+    while (*s == ' ') {
+        s++;
+    }
+
+    /* Skip the weekday and its comma: "Wed, " */
+    const char* comma = strchr(s, ',');
+    if (comma) {
+        s = comma + 1;
+        while (*s == ' ') {
+            s++;
+        }
+    }
+
+    if (sscanf(s, "%d %3s %d %d:%d:%d",
+            &day, mon, &year, &hour, &min, &sec) != 6) {
+        return 0;
+    }
+
+    const char* p = strstr(months, mon);
+    if (!p) {
+        return 0;
+    }
+
+    memset(&tm, 0, sizeof(tm));
+    tm.tm_mday = day;
+    tm.tm_mon = (int)(p - months) / 3;
+    tm.tm_year = year - 1900;
+    tm.tm_hour = hour;
+    tm.tm_min = min;
+    tm.tm_sec = sec;
+
+    return timegm(&tm);
+}
