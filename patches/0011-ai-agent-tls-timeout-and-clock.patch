+    /* SiliconLoop: take the wall clock from the server's Date header.
+     * This board has no RTC, so time starts at 1970 and every evidence
+     * file, cron schedule and get_current_time result is wrong. The
+     * response header carries an accurate UTC timestamp on every call,
+     * so no extra round trip or NTP client is needed.
+     */
+    {
+        char* date_hdr = strcasestr(raw, "\r\nDate:");
+        if (date_hdr && date_hdr < body_start) {
+            time_t srv = parse_http_date(date_hdr + 7);
+            time_t now = time(NULL);
+            if (srv > 0 && (now < srv - 60 || now > srv + 60)) {
+                struct timespec ts = { .tv_sec = srv, .tv_nsec = 0 };
+                clock_settime(CLOCK_REALTIME, &ts);
+                syslog(LOG_INFO,
+                    "[%s] Clock synced from HTTP Date: %ld\n",
+                    TAG, (long)srv);
+            }
+        }
+    }
