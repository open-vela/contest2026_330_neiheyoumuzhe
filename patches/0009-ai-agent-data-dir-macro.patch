+                (char*)AGENT_SECRET_MODEL,
+                (char*)AGENT_SECRET_API_KEY };
+            cmd_set_llm(4, av);
+            BOOT_LOG(&t0, "P3", "llm bootstrap from secrets");
+        }
+
         /* node_manager must init BEFORE tool_registry so it can
          * register itself as a tool provider. */
