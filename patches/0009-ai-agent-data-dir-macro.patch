+        /* SiliconLoop: bootstrap the LLM backend from build-time
+         * secrets. /data is tmpfs on this board, so config.json is
+         * empty on every boot and the router starts with zero
+         * backends. Unattended operation (cron-driven diagnosis)
+         * cannot wait for a human to type set_llm.
+         */
+        if (AGENT_SECRET_LLM_URL[0] && AGENT_SECRET_API_KEY[0]) {
+            char* av[] = { (char*)"set_llm",
