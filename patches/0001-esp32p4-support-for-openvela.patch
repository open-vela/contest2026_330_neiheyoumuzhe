+#ifdef CONFIG_SERIAL_OFLOWCONTROL
+  .ctspin = CONFIG_ESPRESSIF_LPUART0_CTSPIN,
+#ifdef CONFIG_LPUART0_OFLOWCONTROL
+  .oflow  = true,    /* output flow control (CTS) enabled */
+#else
+  .oflow  = false,   /* output flow control (CTS) disabled */
