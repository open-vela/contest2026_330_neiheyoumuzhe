 /* ── Clock-safe elapsed time calculation ───────────────────── */
 
+/* Monotonic clock source for elapsed-time measurement.
+ *
+ * gettimeofday() reads CLOCK_REALTIME, which jumps forward on devices
+ * without an RTC when TLS corrects the system time mid-call (1970 ->
+ * 2026). calc_elapsed_ms() then reports ~31 days and the LLM watchdog
+ * discards an otherwise successful response.
+ *
+ * CLOCK_MONOTONIC is unaffected by wall-clock adjustments. Falls back
+ * to gettimeofday() if the monotonic clock is unavailable.
+ */
+static inline void mono_now(struct timeval *tv)
+{
+    struct timespec ts;
+
+    if (clock_gettime(CLOCK_MONOTONIC, &ts) == 0) {
+        tv->tv_sec  = ts.tv_sec;
+        tv->tv_usec = ts.tv_nsec / 1000;
+        return;
+    }
+
+    gettimeofday(tv, NULL);
+}
+
